{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "ecocollect-frontend": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ecocollect-frontend", "index": "src/index.html",
            "browser": "src/main.ts", "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json", "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {"optimization": true, "outputHashing": "all"},
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "ecocollect-frontend:build:production"},
            "development": {"buildTarget": "ecocollect-frontend:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}